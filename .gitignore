# Publish the retained processed split and the two matching Aug checkpoints.
# New tensorized batches and unrelated checkpoints remain ignored above.
!data/uspto_50k/**/*.file.kekulized
!data/uspto_50k/train/action_freq_map.pkl
!experiment/uspto_50k/without_rxn_class/16-07-2026--01-17-31/epoch_86.pt
